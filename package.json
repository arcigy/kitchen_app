{
  "name": "3d-kuchyna-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/devLocal.ts",
    "dev:vite": "vite --host 127.0.0.1 --port 5180",
    "build": "vite build",
    "build:debug": "tsx scripts/buildSupplierBridge.ts --mode debug",
    "build:production": "tsx scripts/buildSupplierBridge.ts --mode production",
    "build:supplier-simulator": "vite build apps/supplier-simulator --config apps/supplier-simulator/vite.config.ts --outDir dist",
    "build:demos-catalog": "tsx scripts/buildDemosCatalog.ts",
    "generate:module-icons": "node scripts/generateArcigyModuleIcons.mjs",
    "typecheck": "tsc --noEmit && tsc -p apps/supplier-bridge-extension/tsconfig.json --noEmit && tsc -p apps/supplier-simulator/tsconfig.json --noEmit",
    "lint": "eslint apps/supplier-bridge-extension/src apps/supplier-simulator/src src/core/supplier-bridge src/app/supplierBridgeApi.ts src/app/supplierBridgeWebController.ts src/server/supplierBridgeEndpoint.ts src/server/supplierBridgeProjectUpdater.ts scripts/buildSupplierBridge.ts --max-warnings 0",
    "security:secrets": "tsx scripts/scanTrackedSecrets.ts",
    "security:dependencies": "tsx scripts/verifyProductionDependencyAudit.ts",
    "test": "vitest run",
    "test:i18n": "tsx scripts/checkI18nCoverage.ts && vitest run src/i18n apps/supplier-bridge-extension/src/i18n.test.ts src/assistant/assistantLocale.test.ts",
    "test:supplier-bridge": "vitest run src/core/supplier-bridge apps/supplier-bridge-extension/src",
    "test:supplier-bridge:integration": "vitest run src/server/workerServer.test.ts --testNamePattern=\"supplier bridge\"",
    "test:supplier-bridge:e2e": "npm run build:debug && node scripts/testSupplierBridgeE2E.mjs",
    "preview": "vite preview",
    "blender:from-json": "tsx scripts/blender/fromJson.ts",
    "import:modpkg": "tsx scripts/importModpkg.ts",
    "test:pricing-contract": "tsx scripts/testPricingContract.ts",
    "test:assistant-live": "node scripts/testAssistantCapabilitiesLive.mjs",
    "test:assistant-project": "node scripts/testAssistantCapabilitiesPersistedProject.mjs",
    "test:pricing-ui": "node scripts/testPricingUi.mjs",
    "test:kitchen-context-live": "node scripts/testKitchenContextLive.mjs",
    "test:kitchen-performance": "node scripts/testKitchenPerformance.mjs",
    "test:workspace-cold-open": "node scripts/measureWorkspaceColdOpen.mjs",
    "test:saas-load": "tsx scripts/runSaasLoadTest.ts",
    "test:db-restore-drill": "tsx scripts/runPostgresRestoreDrill.ts",
    "test:db-restore-drill:portable": "tsx scripts/runPortablePostgresRestoreDrill.ts",
    "ops:plan-image-retention": "tsx scripts/caproverImageRetentionPlan.ts",
    "ops:storage-manifest": "tsx scripts/storageTreeManifest.ts",
    "test:kitchen-module-edge-cases": "node scripts/testKitchenModuleEdgeCases.mjs",
    "test:module-properties": "node scripts/testModulePropertiesUi.mjs",
    "test:portable-material-live": "node scripts/testPortableMaterialLive.mjs",
    "test:material-proof": "node scripts/testMaterialProofMode.mjs",
    "test:kitchen-module-placement-contract": "tsx scripts/auditKitchenModulePlacementContract.ts --system --module-types=fwm_catalog_base_corner,fwm_catalog_base_doors,fwm_catalog_base_drawers,fwm_catalog_base_open_end,fwm_catalog_tall_cabinet,fwm_tall_open_end,fwm_catalog_wall_cabinet,fwm_catalog_wall_open_end",
    "test:project-save-load": "node scripts/testProjectSaveLoadStability.mjs",
    "test:project-roundtrip-full": "node scripts/testProjectRoundtripFull.mjs",
    "test:ui-smoke": "node scripts/testFullUiSmoke.mjs",
    "test:context-menu-ui": "node scripts/testContextMenusUi.mjs",
    "test:accessibility": "node scripts/testAccessibilitySmoke.mjs",
    "test:ui-regression": "npm run test:ui-smoke && npm run test:context-menu-ui && npm run test:accessibility && npm run test:i18n-ui && npm run test:kitchen-context-live && npm run test:kitchen-module-edge-cases && npm run test:pricing-ui && npm run test:module-properties && npm run test:portable-material-live && npm run test:material-proof && npm run test:project-save-load && npm run test:project-roundtrip-full",
    "test:i18n-ui": "node scripts/testI18nUi.mjs",
    "worker:dev": "tsx scripts/worker.ts",
    "dev:supplier-simulator": "vite apps/supplier-simulator --config apps/supplier-simulator/vite.config.ts",
    "dev:local": "tsx scripts/devLocal.ts",
    "dev:local:postgres": "tsx scripts/devLocalPostgres.ts",
    "dev:online:postgres": "tsx scripts/devOnlinePostgres.ts",
    "serve:caprover": "tsx scripts/worker.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:init": "tsx scripts/initProjectDatabase.ts",
    "db:migrate": "tsx scripts/dbMigrate.ts",
    "db:seed": "tsx scripts/dbSeedArcigy.ts",
    "db:seed:pino-nobilia": "tsx scripts/dbSeedPinoNobilia.ts",
    "db:assign-client-modules": "tsx scripts/assignClientModules.ts",
    "db:assign-client-suppliers": "tsx scripts/assignClientSuppliers.ts",
    "db:set-client-currency": "tsx scripts/setClientCurrency.ts",
    "odoo:feedback:setup": "tsx scripts/setupOdooFeedbackProject.ts --apply"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "html2canvas": "^1.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.21.0",
    "polygon-clipping": "^0.15.7",
    "postprocessing": "^6.39.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "realism-effects": "^1.1.2",
    "three": "^0.168.0",
    "three-gpu-pathtracer": "0.0.20",
    "three-mesh-bvh": "^0.9.9",
    "tsx": "^4.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "ts-morph": "^28.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.63.0",
    "vite": "6.4.3",
    "vitest": "^4.1.5"
  }
}

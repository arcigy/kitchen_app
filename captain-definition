{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:22-alpine AS build",
    "WORKDIR /app",
    "COPY package*.json ./",
    "RUN npm ci",
    "COPY . .",
    "RUN npm run build",
    "",
    "FROM node:22-alpine",
    "WORKDIR /app",
    "ENV NODE_ENV=production",
    "ENV KITCHEN_STATIC_ROOT=/app/dist",
    "ENV KITCHEN_APP_PROJECT_ROOT=/app",
    "COPY --from=build /app /app",
    "RUN apk add --no-cache nginx",
    "COPY deploy/nginx.conf /etc/nginx/nginx.conf",
    "COPY deploy/nginx-security-headers.conf /etc/nginx/arcigy-security-headers.conf",
    "RUN chmod +x /app/scripts/startCapRover.sh",
    "EXPOSE 80",
    "CMD [\"/app/scripts/startCapRover.sh\"]"
  ]
}

{
  "schemaVersion": "module-system-parameters.v1",
  "groups": [
    {
      "key": "identity",
      "label": "Identity",
      "description": "Fixed identity metadata required for each exported module instance."
    },
    {
      "key": "dimensions",
      "label": "Dimensions",
      "description": "Nominal module dimensions in millimeters."
    },
    {
      "key": "placement",
      "label": "Placement",
      "description": "Scene placement metadata for the exported module instance."
    },
    {
      "key": "pricing",
      "label": "Pricing",
      "description": "Pricing overrides and commercial state used by downstream systems."
    },
    {
      "key": "state",
      "label": "State",
      "description": "Lifecycle and validation state flags for the module."
    },
    {
      "key": "metadata",
      "label": "Metadata",
      "description": "Human-facing metadata kept alongside the technical module export."
    },
    {
      "key": "ifc",
      "label": "IFC Export",
      "description": "IFC export defaults and BIM classification metadata."
    }
  ],
  "definitions": [
    {
      "key": "typeId",
      "group": "identity",
      "type": "string",
      "description": "Stable identifier of the module type used across exports and downstream mappings.",
      "required": true
    },
    {
      "key": "type",
      "group": "identity",
      "type": "string",
      "description": "Technical module type.",
      "required": true
    },
    {
      "key": "displayName",
      "group": "identity",
      "type": "string",
      "description": "Human-readable module name.",
      "required": true
    },
    {
      "key": "family",
      "group": "identity",
      "type": "string",
      "description": "Higher-level module family.",
      "required": true
    },
    {
      "key": "code",
      "group": "identity",
      "type": "string | null",
      "description": "Internal or catalog code.",
      "required": true
    },
    {
      "key": "variant",
      "group": "identity",
      "type": "string | null",
      "description": "Concrete module variant.",
      "required": true
    },
    {
      "key": "version",
      "group": "identity",
      "type": "string",
      "description": "Module data-model/export version.",
      "required": true
    },
    {
      "key": "widthMm",
      "group": "dimensions",
      "type": "number",
      "description": "Nominal width in mm.",
      "required": true
    },
    {
      "key": "heightMm",
      "group": "dimensions",
      "type": "number",
      "description": "Nominal height in mm.",
      "required": true
    },
    {
      "key": "depthMm",
      "group": "dimensions",
      "type": "number",
      "description": "Nominal depth in mm.",
      "required": true
    },
    {
      "key": "positionXmm",
      "group": "placement",
      "type": "number",
      "description": "X position in mm.",
      "required": true
    },
    {
      "key": "positionYmm",
      "group": "placement",
      "type": "number",
      "description": "Y position in mm.",
      "required": true
    },
    {
      "key": "positionZmm",
      "group": "placement",
      "type": "number",
      "description": "Z position in mm.",
      "required": true
    },
    {
      "key": "rotationZDeg",
      "group": "placement",
      "type": "number",
      "description": "Rotation around Z in degrees.",
      "required": true
    },
    {
      "key": "customPriceOverride",
      "group": "pricing",
      "type": "number | null",
      "description": "Sales price override.",
      "required": true
    },
    {
      "key": "pricingEnabled",
      "group": "pricing",
      "type": "boolean",
      "description": "Pricing enabled flag.",
      "required": true
    },
    {
      "key": "priceSource",
      "group": "pricing",
      "type": "\"calculated\" | \"override\" | \"manual\" | \"catalog\"",
      "description": "Final price source.",
      "required": true
    },
    {
      "key": "costOverride",
      "group": "pricing",
      "type": "number | null",
      "description": "Internal cost override.",
      "required": true
    },
    {
      "key": "quantity",
      "group": "pricing",
      "type": "number",
      "description": "Quantity.",
      "required": true
    },
    {
      "key": "isActive",
      "group": "state",
      "type": "boolean",
      "description": "Active state.",
      "required": true
    },
    {
      "key": "isVisible",
      "group": "state",
      "type": "boolean",
      "description": "Visibility state.",
      "required": true
    },
    {
      "key": "isLocked",
      "group": "state",
      "type": "boolean",
      "description": "Lock state.",
      "required": true
    },
    {
      "key": "isValid",
      "group": "state",
      "type": "boolean",
      "description": "Validation state.",
      "required": true
    },
    {
      "key": "validationErrors",
      "group": "state",
      "type": "string[]",
      "description": "Validation errors/warnings.",
      "required": true
    },
    {
      "key": "notes",
      "group": "metadata",
      "type": "string | null",
      "description": "Internal note.",
      "required": true
    },
    {
      "key": "tags",
      "group": "metadata",
      "type": "string[]",
      "description": "Module tags.",
      "required": true
    },
    {
      "key": "createdAt",
      "group": "metadata",
      "type": "string | null",
      "description": "Creation timestamp.",
      "required": true
    },
    {
      "key": "updatedAt",
      "group": "metadata",
      "type": "string | null",
      "description": "Update timestamp.",
      "required": true
    },
    {
      "key": "exportToIfc",
      "group": "ifc",
      "type": "boolean",
      "description": "IFC export flag.",
      "required": true
    },
    {
      "key": "ifcClass",
      "group": "ifc",
      "type": "string | null",
      "description": "IFC class.",
      "required": true
    },
    {
      "key": "ifcPredefinedType",
      "group": "ifc",
      "type": "string | null",
      "description": "IFC predefined type.",
      "required": true
    },
    {
      "key": "ifcName",
      "group": "ifc",
      "type": "string | null",
      "description": "IFC name.",
      "required": true
    },
    {
      "key": "ifcDescription",
      "group": "ifc",
      "type": "string | null",
      "description": "IFC description.",
      "required": true
    },
    {
      "key": "ifcObjectType",
      "group": "ifc",
      "type": "string | null",
      "description": "IFC object type.",
      "required": true
    },
    {
      "key": "ifcTag",
      "group": "ifc",
      "type": "string | null",
      "description": "IFC tag.",
      "required": true
    },
    {
      "key": "classificationCode",
      "group": "ifc",
      "type": "string | null",
      "description": "Classification code.",
      "required": true
    },
    {
      "key": "classificationSystem",
      "group": "ifc",
      "type": "string | null",
      "description": "Classification system.",
      "required": true
    }
  ]
}
<odoo>
  <record id="search" model="ir.ui.view"><field name="name">Arcigy feedback search</field><field name="model">project.task</field><field name="arch" type="xml">
    <search><field name="arcigy_title"/><field name="arcigy_body"/><field name="arcigy_company"/><field name="arcigy_author"/><field name="arcigy_kind"/><field name="arcigy_status"/><field name="arcigy_environment"/>
      <filter name="open" string="Nevyriešené" domain="[('arcigy_status','!=','main')]"/>
      <filter name="main" string="Z Mainu" domain="[('arcigy_environment','=','main')]"/>
      <filter name="develop" string="Z Developu" domain="[('arcigy_environment','=','develop')]"/>
      <filter name="review" string="Na preverenie" domain="[('arcigy_status','=','review')]"/>
      <group><filter name="company" string="Firma" context="{'group_by':'arcigy_company'}"/>
      <filter name="status" string="Stav" context="{'group_by':'arcigy_status'}"/>
      <filter name="environment" string="Prostredie" context="{'group_by':'arcigy_environment'}"/></group>
    </search>
  </field></record>
  <record id="list" model="ir.ui.view"><field name="name">Arcigy feedback list</field><field name="model">project.task</field><field name="priority">100</field><field name="arch" type="xml">
    <list create="0" delete="0" default_order="id desc" js_class="arcigy_feedback_list">
      <field name="id" string="Číslo"/><field name="arcigy_title" string="Hlásenie"/>
      <field name="arcigy_environment" string="Odkiaľ" widget="badge"/><field name="arcigy_company" string="Firma"/>
      <field name="arcigy_author" string="Autor"/><field name="arcigy_status" string="Stav" widget="badge"/>
      <field name="create_date" string="Prijaté"/><field name="arcigy_worker" string="Pracuje na tom" optional="hide"/>
    </list>
  </field></record>
  <record id="kanban" model="ir.ui.view"><field name="name">Arcigy feedback cards</field><field name="model">project.task</field><field name="priority">100</field><field name="arch" type="xml">
    <kanban create="0" delete="0" default_order="id desc" class="arcigy-feedback-cards" js_class="arcigy_feedback_kanban">
      <templates><t t-name="card">
        <div class="d-flex justify-content-between gap-2"><field name="arcigy_environment" widget="badge"/><field name="arcigy_status" widget="badge"/></div>
        <h3 class="my-3"><field name="arcigy_title"/></h3>
        <div class="fw-bold"><field name="arcigy_company"/><span invisible="arcigy_company">Firma nezistená</span></div><div><field name="arcigy_author"/><span invisible="arcigy_author">Autor nezistený</span></div>
        <div class="text-muted mt-2"><field name="create_date"/></div>
      </t></templates>
    </kanban>
  </field></record>
  <record id="form" model="ir.ui.view"><field name="name">Arcigy feedback detail</field><field name="model">project.task</field><field name="priority">100</field><field name="arch" type="xml">
    <form create="0" delete="0" edit="0" class="arcigy-feedback-detail" js_class="arcigy_feedback_form">
      <header><field name="arcigy_status" widget="statusbar" statusbar_visible="review,new,working,implemented,develop,main"/></header>
      <sheet>
        <div class="d-flex flex-wrap gap-2 mb-3"><field name="arcigy_environment" widget="badge"/><field name="arcigy_kind" widget="badge"/></div>
        <h1><field name="arcigy_title"/></h1>
        <group><group><field name="arcigy_company" string="Firma"/><field name="arcigy_author" string="Poslal"/></group>
          <group><field name="create_date" string="Prijaté"/><field name="arcigy_worker" string="Pracuje na tom"/></group></group>
        <h2>Čo používateľ napísal</h2><field name="arcigy_body" nolabel="1" class="arcigy-feedback-text"/>
        <h3 invisible="not arcigy_comment">Doplňujúci komentár</h3><field name="arcigy_comment" nolabel="1" invisible="not arcigy_comment"/>
        <field name="arcigy_screenshot_data" widget="image" nolabel="1" options="{'size':[1200,800]}"/>
        <details class="mt-4"><summary>Priebeh opravy a nasadenia</summary><field name="arcigy_timeline_html" nolabel="1"/></details>
        <details class="mt-4"><summary>Technické podklady pre opravu</summary><group>
          <field name="id" string="Číslo hlásenia"/><field name="arcigy_tenant_id" string="Tenant"/><field name="arcigy_user_id" string="Používateľ"/>
          <field name="arcigy_source_commit" string="Verzia aplikácie"/><field name="arcigy_captured_at" string="Zachytené"/>
          <field name="arcigy_manifest" string="Zoznam súborov"/><field name="arcigy_metadata" string="Diagnostika"/>
        </group></details>
      </sheet><chatter/>
    </form>
  </field></record>
  <record id="action" model="ir.actions.act_window"><field name="name">Arcigy podpora</field><field name="res_model">project.task</field>
    <field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="search"/>
    <field name="domain">[('arcigy_report','=',True),('arcigy_ready','=',True)]</field><field name="context">{'search_default_open':1}</field>
  </record>
  <record id="action_kanban" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">kanban</field><field name="view_id" ref="kanban"/><field name="act_window_id" ref="action"/></record>
  <record id="action_list" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">list</field><field name="view_id" ref="list"/><field name="act_window_id" ref="action"/></record>
  <record id="action_form" model="ir.actions.act_window.view"><field name="sequence">3</field><field name="view_mode">form</field><field name="view_id" ref="form"/><field name="act_window_id" ref="action"/></record>
  <menuitem id="menu" name="Arcigy podpora" action="action" sequence="5" groups="group_manager"/>
</odoo>
